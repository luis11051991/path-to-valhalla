# Variables de entorno para backend

# JWT Secret - debe ser una cadena aleatoria de al menos 32 caracteres
JWT_SECRET=

# Firebase Admin SDK - se cargará desde variables de entorno o secret manager
# No colocar aquí credenciales sensibles en este archivo

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100

# Logging
NODE_ENV=development
LOG_LEVEL=info