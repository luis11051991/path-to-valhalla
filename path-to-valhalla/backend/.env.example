# Environment (development | production)
NODE_ENV=development

# Port server
PORT=3000

# Database connection (preferido) - usa este o las variables PG_*
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/path-to-valhalla

# Database fallback (si DATABASE_URL no se setea)
PGHOST=localhost
PGPORT=5432
PGDATABASE=path-to-valhalla
PGUSER=postgres
PGPASSWORD=

# JWT secret - CAMBIA ESTO en produccion
JWT_SECRET=cambiar-esto-por-un-seguro-random
JWT_EXPIRES_IN=7d

# CORS origin (lista separada por comas o *)
CORS_ORIGIN=*
