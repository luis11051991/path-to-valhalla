INSERT INTO public.classes VALUES (22, 'Baluarte Inquebrantable', 'Ni ejércitos enteros pueden moverlo. Es la defensa absoluta.', 2, 50, 20, 'dwarf', '/classes/dwarf_t2_b.png', '{"luck": 2, "charisma": 0, "strength": 4, "dexterity": 2, "constitution": 12, "intelligence": 0}');
INSERT INTO public.classes VALUES (27, 'Sombra Caótica', 'El caos es su herramienta. Sus enemigos mueren sin saber de dónde vino el golpe.', 2, 50, 25, 'goblin', '/classes/goblin_t2_a.png', '{"luck": 4, "charisma": 0, "strength": 0, "dexterity": 8, "constitution": 0, "intelligence": 6}');
INSERT INTO public.classes VALUES (28, 'Tecnomante Siniestro', 'La tecnología y la magia negra se fusionan en sus creaciones. Sus artefactos siembran muerte.', 2, 50, 26, 'goblin', '/classes/goblin_t2_b.png', '{"luck": 2, "charisma": 0, "strength": 0, "dexterity": 4, "constitution": 4, "intelligence": 10}');
INSERT INTO public.classes VALUES (33, 'Tormenta de Guerra', 'Arrasa el campo de batalla como un huracán de acero y sangre.', 2, 50, 31, 'orc', '/classes/orc_t2_a.png', '{"luck": 0, "charisma": 0, "strength": 12, "dexterity": 3, "constitution": 6, "intelligence": 0}');
INSERT INTO public.classes VALUES (34, 'El Inmortal', 'Ha sobrevivido a todo. Las heridas que matarían a cualquier otro solo lo enfurecen.', 2, 50, 32, 'orc', '/classes/orc_t2_b.png', '{"luck": 2, "charisma": 0, "strength": 6, "dexterity": 0, "constitution": 12, "intelligence": 0}');
INSERT INTO public.classes VALUES (39, 'Garras del Crepúsculo', 'Caza en la penumbra. Sus ojos ven lo que otros no pueden. Sus garras alcanzan lo imposible.', 2, 50, 37, 'feline', '/classes/feline_t2_a.png', '{"luck": 6, "charisma": 0, "strength": 4, "dexterity": 10, "constitution": 0, "intelligence": 0}');
INSERT INTO public.classes VALUES (40, 'Avatar de la Cacería', 'La cacería eterna lo consume. Cada presa caída lo hace más fuerte.', 2, 50, 38, 'feline', '/classes/feline_t2_b.png', '{"luck": 2, "charisma": 0, "strength": 8, "dexterity": 6, "constitution": 4, "intelligence": 0}');
INSERT INTO public.classes VALUES (11, 'Señor de la Guerra', 'Leyenda viviente. Los ejércitos se arrodillan a su paso. La guerra misma le obedece.', 3, 100, 9, 'human', '/classes/human_t3_a.png', '{"luck": 0, "charisma": 4, "strength": 14, "dexterity": 10, "constitution": 8, "intelligence": 4}');
INSERT INTO public.classes VALUES (12, 'Oráculo de Guerra', 'Ve el futuro en cada movimiento. El destino mismo se pliega a su voluntad.', 3, 100, 10, 'human', '/classes/human_t3_b.png', '{"luck": 4, "charisma": 12, "strength": 4, "dexterity": 4, "constitution": 0, "intelligence": 14}');
INSERT INTO public.classes VALUES (17, 'Fantasma del Vendaval', 'Nadie lo ha visto y vivido para contarlo. Es la tormenta perfecta, la muerte hecha viento.', 3, 100, 15, 'elf', '/classes/elf_t3_a.png', '{"luck": 8, "charisma": 0, "strength": 4, "dexterity": 16, "constitution": 0, "intelligence": 8}');
INSERT INTO public.classes VALUES (18, 'La Parca Silenciosa', 'No hay rastro, no hay advertencia. Solo silencio, y luego la muerte.', 3, 100, 16, 'elf', '/classes/elf_t3_b.png', '{"luck": 6, "charisma": 0, "strength": 0, "dexterity": 10, "constitution": 6, "intelligence": 14}');
INSERT INTO public.classes VALUES (23, 'Señor de las Runas', 'Las runas antiguas le revelaron sus secretos. Su poder forja el destino de los mundos.', 3, 100, 21, 'dwarf', '/classes/dwarf_t3_a.png', '{"luck": 4, "charisma": 0, "strength": 12, "dexterity": 4, "constitution": 10, "intelligence": 8}');
INSERT INTO public.classes VALUES (24, 'Muralla de Mithril', 'Impenetrable. Indestructible. Eterna. Ni los dioses pueden derribarlo.', 3, 100, 22, 'dwarf', '/classes/dwarf_t3_b.png', '{"luck": 4, "charisma": 0, "strength": 8, "dexterity": 4, "constitution": 22, "intelligence": 0}');
INSERT INTO public.classes VALUES (29, 'Príncipe del Caos', 'El caos no es aleatorio; es su voluntad. Todo conspira para destruir a sus enemigos.', 3, 100, 27, 'goblin', '/classes/goblin_t3_a.png', '{"luck": 10, "charisma": 0, "strength": 0, "dexterity": 14, "constitution": 0, "intelligence": 12}');
INSERT INTO public.classes VALUES (30, 'Arquitecto de la Plaga', 'Sus creaciones han diezmado civilizaciones enteras. La destrucción es su obra de arte.', 3, 100, 28, 'goblin', '/classes/goblin_t3_b.png', '{"luck": 4, "charisma": 0, "strength": 0, "dexterity": 8, "constitution": 6, "intelligence": 20}');
INSERT INTO public.classes VALUES (35, 'Cataclismo Viviente', 'Donde pisa, la tierra tiembla. Donde golpea, montañas se derrumban. Es el fin.', 3, 100, 33, 'orc', '/classes/orc_t3_a.png', '{"luck": 0, "charisma": 0, "strength": 22, "dexterity": 6, "constitution": 10, "intelligence": 0}');
INSERT INTO public.classes VALUES (36, 'Titán Indestructible', 'Ha desafiado a la muerte misma y ganó. Su existencia es una afrenta a los dioses.', 3, 100, 34, 'orc', '/classes/orc_t3_b.png', '{"luck": 6, "charisma": 0, "strength": 12, "dexterity": 0, "constitution": 22, "intelligence": 0}');
INSERT INTO public.classes VALUES (41, 'Pesadilla Nocturna', 'El miedo de sus enemigos le da poder. En la oscuridad, es el cazador supremo.', 3, 100, 39, 'feline', '/classes/feline_t3_a.png', '{"luck": 12, "charisma": 0, "strength": 8, "dexterity": 18, "constitution": 0, "intelligence": 0}');
INSERT INTO public.classes VALUES (42, 'Dios de la Presa', 'La cacería eterna ha terminado. Ya no caza; decide quién merece ser cazado.', 3, 100, 40, 'feline', '/classes/feline_t3_b.png', '{"luck": 4, "charisma": 0, "strength": 14, "dexterity": 10, "constitution": 8, "intelligence": 0}');


