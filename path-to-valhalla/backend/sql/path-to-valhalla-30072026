INSERT INTO public.expeditions VALUES (1, 'Fiordo de los Exiliados', 'Un fiordo glaciar donde antiguas manadas de lobos gigantes vagan entre el hielo eterno. Se dice que los aullidos que resuenan entre los acantilados no son solo animales, sino espíritus guardianes de un antiguo pacto roto entre hombres y bestias.', 1, 5, 60, '{}', 100, 10, 50, '/locations/fiord_of_the_exiled.png');
INSERT INTO public.expeditions VALUES (2, 'Bosque de la Madera Funesta', 'Un bosque de árboles retorcidos cuya madera fue usada para construir ataúdes y piras funerarias durante una guerra olvidada. Las hojas nunca caen del todo, y los viajeros juran ver siluetas colgadas entre las ramas al caer la noche.', 2, 5, 60, '{}', 100, 10, 50, '/locations/gravewood_forest.png');
INSERT INTO public.expeditions VALUES (3, 'Colinas del Colmillo de Piedra', 'Colinas rocosas con formaciones que parecen enormes mandíbulas emergiendo de la tierra. Antiguas leyendas afirman que estas colinas son los restos petrificados de una bestia colosal derrotada por los dioses.', 3, 5, 60, '{}', 100, 10, 50, '/locations/stonefang_hills.png');
INSERT INTO public.expeditions VALUES (4, 'Llanuras de la Garra Sangrienta', 'Extensas praderas marcadas por incontables batallas tribales. La hierba adquiere un tono rojizo cada primavera, como si la tierra recordara la sangre derramada por clanes que lucharon hasta la extinción.', 4, 5, 60, '{}', 100, 10, 50, '/locations/bloodpaw_plains.png');
INSERT INTO public.expeditions VALUES (5, 'Cementerios Olvidados', 'Un vasto terreno cubierto de túmulos erosionados y lápidas sin nombre. Aquí yacen héroes, traidores y reyes por igual, abandonados por la historia. Las noches son inquietantes, pues los muertos no siempre descansan en silencio.', 5, 5, 60, '{}', 100, 10, 50, '/locations/forgotten_burial_grounds.png');
INSERT INTO public.expeditions VALUES (6, 'Costa de las Mareas Naufragadas', 'Una costa traicionera donde corrientes impredecibles han destrozado cientos de barcos. Los restos de navíos sobresalen de la arena como huesos blanqueados, y algunos dicen que las mareas arrastran ecos de antiguos gritos de auxilio.', 6, 5, 60, '{}', 100, 10, 50, '/locations/tidewreck_shore.png');
INSERT INTO public.expeditions VALUES (7, 'Paso del Colmillo de Escarcha', 'Un estrecho paso montañoso azotado por ventiscas eternas. Fue la única ruta entre dos reinos enemigos, y aún hoy el hielo guarda armas y cadáveres congelados, intactos como el día de su muerte.', 7, 5, 60, '{}', 100, 10, 50, '/locations/frostfang_pass.png');
INSERT INTO public.expeditions VALUES (8, 'Espesura del Pino Sombrío', 'Un bosque denso donde la luz apenas penetra entre los pinos negros. Las sombras parecen moverse por voluntad propia, y los cazadores evitan la zona tras perder compañeros que simplemente se desvanecieron entre los árboles.', 8, 5, 60, '{}', 100, 10, 50, '/locations/shadowpine_thicket.png');
INSERT INTO public.expeditions VALUES (9, 'Barranco del Hueso Escarpado', 'Un profundo barranco cuyas paredes están cubiertas de fósiles gigantescos. Se cree que fue un antiguo campo de batalla entre titanes, y que los huesos incrustados aún emanan una energía peligrosa.', 9, 5, 60, '{}', 100, 10, 50, '/locations/cragbone_ravine.png');
INSERT INTO public.expeditions VALUES (10, 'Vientos de los Caídos', 'Una región elevada donde soplan corrientes constantes y lamentos espectrales viajan con el viento. Los guerreros creen que aquí las almas de los caídos nunca abandonaron el mundo, y que el viento susurra sus últimos juramentos.', 10, 5, 60, '{}', 100, 10, 50, '/locations/winds_of_the_fallen.png');
