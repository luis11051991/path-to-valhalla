CREATE FUNCTION public.heal_on_level_up() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
DECLARE
    con_val INT;
    calc_max_hp INT;
BEGIN
    -- Solo actuar si el nivel sube
    IF NEW.level > OLD.level THEN
        -- Extraer Constitución del JSON (Si no existe, asume 10)
        con_val := COALESCE((NEW.stats->>'constitution')::INT, 10);
        
        -- Calcular HP Máximo Real: Base 100 + (Constitución * 20)
        calc_max_hp := 100 + (con_val * 20);

        -- Asignar la vida calculada (No 100,000)
        NEW.current_hp = calc_max_hp;
        
        -- Rellenar energías
        NEW.energy = NEW.max_energy;
        NEW.valor = NEW.max_valor;
    END IF;
    RETURN NEW;
END;
$$;


