rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function playerExists(playerId) {
      return exists(/databases/$(database)/documents/players/$(playerId));
    }

    function isPlayerOwner(playerId) {
      return isSignedIn()
        && playerExists(playerId)
        && get(/databases/$(database)/documents/players/$(playerId)).data.firebase_uid == request.auth.uid;
    }

    function isMessageParticipant() {
      return isSignedIn() && (
        (resource.data.sender_id != null && isPlayerOwner(resource.data.sender_id)) ||
        (resource.data.recipient_id != null && isPlayerOwner(resource.data.recipient_id))
      );
    }

    // Player principal: solo su dueño puede leerlo directo desde cliente.
    // Todas las escrituras deben pasar por el backend (firebase-admin).
    match /players/{playerId} {
      allow get: if isSignedIn() && resource.data.firebase_uid == request.auth.uid;
      allow list: if false;
      allow create, update, delete: if false;

      // Subcolecciones privadas del jugador.
      match /{subcollection}/{docId} {
        allow get, list: if isPlayerOwner(playerId);
        allow create, update, delete: if false;
      }
    }

    // Mensajes globales: lectura solo si el usuario participa.
    // Escrituras bloqueadas desde cliente; se hacen por backend.
    match /messages/{messageId} {
      allow get, list: if isMessageParticipant();
      allow create, update, delete: if false;
    }

    // Relacion jugador-fondos: lectura solo para el dueño.
    match /player_backgrounds/{bgId} {
      allow get, list: if isSignedIn()
        && resource.data.player_id != null
        && isPlayerOwner(resource.data.player_id);
      allow create, update, delete: if false;
    }

    // Catalogos estaticos: lectura publica, sin escrituras desde cliente.
    match /classes/{classId} {
      allow read: if true;
      allow write: if false;
    }

    match /items_templates/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    match /enemies/{enemyId} {
      allow read: if true;
      allow write: if false;
    }

    match /enemies/{enemyId}/drops/{dropId} {
      allow read: if true;
      allow write: if false;
    }

    match /expeditions/{expeditionId} {
      allow read: if true;
      allow write: if false;
    }

    match /quests/{questId} {
      allow read: if true;
      allow write: if false;
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if false;
    }

    match /pets/{petId} {
      allow read: if true;
      allow write: if false;
    }

    match /backgrounds/{bgId} {
      allow read: if true;
      allow write: if false;
    }

    match /professions/{profId} {
      allow read: if true;
      allow write: if false;
    }

    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    // Denegar cualquier ruta no contemplada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
